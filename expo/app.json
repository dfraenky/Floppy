{
  "expo": {
    "name": "Floppy",
    "slug": "floppy-expo",
    "scheme": "floppy-expo",
    "version": "1.2.0",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.floppy.nativeproof",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Floppy searches your local network for Floppy servers you can connect to.",
        "NSBonjourServices": [
          "_http._tcp."
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_LOCAL_NETWORK",
        "android.permission.VIBRATE"
      ],
      "package": "app.floppy.nativeproof",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1e1b4b"
      },
      "versionCode": 7
    },
    "experiments": {
      "baseUrl": "/static/expo"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Floppy to scan book barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Floppy to read an ISBN barcode from a photo."
        }
      ],
      "expo-secure-store",
      [
        "expo-router",
        {
          "root": "./app/routes"
        }
      ],
      "expo-status-bar",
      "./plugins/withAndroidLocalBuild"
    ],
    "icon": "./assets/app-icon.png"
  }
}
